# ============================================
# Database
# ============================================
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_SSL=false

# ============================================
# Server / URLs
# ============================================
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

# ============================================
# Auth / JWT
# ============================================
JWT_ACCESS_SECRET=replace_with_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters

# ============================================
# Cookies
# ============================================
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============================================
# Storage
# ============================================
PRIVATE_STORAGE_DIR=private-storage

# ============================================
# Payments (Chapa)
# ============================================
CHAPA_MODE=test
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# ============================================
# Email / SMTP
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ============================================
# Bootstrap (one-time db:bootstrap only — remove after use)
# ============================================
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# ============================================
# App Environment
# ============================================
# Set to "production" for public deployment (enforces HTTPS, secure cookies, live payments)
APP_ENV=development
# Optional dedicated development shadow database for Prisma Migrate
SHADOW_DATABASE_URL=
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional sample-account seed password (12+ characters); never use sample accounts in production
SEED_ACCOUNT_PASSWORD=
